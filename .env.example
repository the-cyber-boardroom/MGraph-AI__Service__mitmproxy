# Configuration for the docker-compose local execution mode
#
# Copy to .env (same folder as docker-compose.yml) and adjust:
#     cp .env.example .env
#
# Every value has a working default in docker-compose.yml, so this file is
# only needed to override something (image version, ports, credentials, S3).

# --- Images ---------------------------------------------------------------
# Pin the service image to a released version to test a specific deploy
#SERVICE_VERSION=latest
#MITMPROXY_VERSION=latest

# --- Ports ----------------------------------------------------------------
#SERVICE_PORT=10011
#PROXY_PORT=8080
#PROXY_WEB_PORT=8081

# --- Auth between interceptor and service ---------------------------------
#FAST_API__AUTH__API_KEY__NAME=x-api-key
#FAST_API__AUTH__API_KEY__VALUE=local-dev-key

# --- Proxy credentials (what the browser logs in with) --------------------
#PROXY_AUTH_USER=mitm-user
#PROXY_AUTH_PASS=mitm-pass

# --- S3-backed cache + inject scripts (mitm-mode=inject) ------------------
# Scripts are loaded from s3://{bucket}/{namespace}/inject/data/sites/{domain}/filter.js
#CACHE__SERVICE__BUCKET_NAME=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=eu-west-1
# note: use AWS_DEFAULT_REGION, never AWS_REGION (AWS_REGION switches the service into Lambda mode)

# --- AWS Comprehend proxy (sentiment modes, e.g. mitm-mode=xxx-negative) --
#AUTH__SERVICE__AWS__COMPREHEND__BASE_URL=
#AUTH__SERVICE__AWS__COMPREHEND__KEY_NAME=
#AUTH__SERVICE__AWS__COMPREHEND__KEY_VALUE=
