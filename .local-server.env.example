# Local development environment for the FastAPI service
#
# Copy this file to .local-server.env and fill in the values:
#     cp .local-server.env.example .local-server.env
#
# It is loaded by ./scripts/run-locally.sh which starts the service on port 10016

# --- Required: API key used to authenticate calls to this service ---------------
# The mitmproxy interceptor must send this same key (see tests/integration/service/mitmproxy/.build.env)
FAST_API__AUTH__API_KEY__NAME=x-api-key
FAST_API__AUTH__API_KEY__VALUE=local-dev-key

# --- Optional: AWS Comprehend service (needed for sentiment modes) --------------
# Required for mitm-mode values that use sentiment analysis (e.g. xxx-negative).
# Hash-based modes (hashes, xxx, abcde-by-size, roundtrip) work without these.
#AUTH__SERVICE__AWS__COMPREHEND__BASE_URL=
#AUTH__SERVICE__AWS__COMPREHEND__KEY_NAME=
#AUTH__SERVICE__AWS__COMPREHEND__KEY_VALUE=

# --- Optional: S3 bucket for the cache service (and inject mode scripts) --------
# Needed for cache persistence and for mitm-mode=inject (loads sites/{domain}/filter.js)
#CACHE__SERVICE__BUCKET_NAME=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=eu-west-1
