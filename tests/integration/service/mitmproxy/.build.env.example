# Build-time environment for the local mitmproxy Docker container
#
# Copy this file to .build.env (in this folder) and fill in the values:
#     cp tests/integration/service/mitmproxy/.build.env.example tests/integration/service/mitmproxy/.build.env
#
# These values are read by Mitmproxy__Create__Docker_Container.build_custom_image()
# and baked into the custom mitmproxy image as ENV vars for fastapi_interceptor.py

# Where the interceptor reaches the local FastAPI service (started by ./scripts/run-locally.sh)
# host.docker.internal works out of the box on macOS/Windows;
# on Linux use the docker bridge IP (usually http://172.17.0.1:10016) or your machine's LAN IP
FASTAPI_BASE_URL=http://host.docker.internal:10016

# Must match FAST_API__AUTH__API_KEY__NAME / __VALUE in .local-server.env
FASTAPI_API_KEY_NAME=x-api-key
FASTAPI_API_KEY_VALUE=local-dev-key

# Credentials the browser must provide to use the proxy (mitmdump --proxyauth)
PROXY_AUTH_USER=mitm-user
PROXY_AUTH_PASS=change-me
